### változók
@protocol = http://
@hostname = 127.0.0.1
@port = 8000
@host = {{protocol}}{{hostname}}:{{port}}

### seedelt login adatok
@admin_email = admin@doomshoprecords.com
@admin_password = admin123
@customer_email = customer@doomshoprecords.com
@customer_password = customer123

### dinamikus teszt adatok
@run = {{$timestamp}}

### health
GET {{host}}/api/x
Accept: application/json


### ADMIN LOGIN
# @name login_admin
POST {{host}}/api/users/login
Accept: application/json
Content-Type: application/json

{
  "email": "{{admin_email}}",
  "password": "{{admin_password}}"
}

###
@admin_token = {{login_admin.response.body.data.token}}
@admin_id = {{login_admin.response.body.data.id}}


### CUSTOMER LOGIN
# @name login_customer
POST {{host}}/api/users/login
Accept: application/json
Content-Type: application/json

{
  "email": "{{customer_email}}",
  "password": "{{customer_password}}"
}

###
@customer_token = {{login_customer.response.body.data.token}}
@customer_id = {{login_customer.response.body.data.id}}


### alap token (admin)
@token = {{admin_token}}


// -------------------------------
// USERSME (self)
// -------------------------------

### me
GET {{host}}/api/usersme
Accept: application/json
Authorization: Bearer {{customer_token}}

### self update (name/email)
PATCH {{host}}/api/usersme
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{customer_token}}

{
  "name": "Customer {{$timestamp}}"
}

### self password update
PATCH {{host}}/api/usersmeupdatepassword
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{customer_token}}

{
  "oldpassword": "customer123",
  "newpassword": "customer123",
  "newpassword_confirmation": "customer123"
}

### self delete (VESZELYES - csak teszt useren futtasd)
DELETE {{host}}/api/usersme
Accept: application/json
Authorization: Bearer {{customer_token}}


// -------------------------------
// USERS (admin)
// -------------------------------

### get users
GET {{host}}/api/users
Accept: application/json
Authorization: Bearer {{admin_token}}

### get user by id
GET {{host}}/api/users/{{customer_id}}
Accept: application/json
Authorization: Bearer {{admin_token}}

### post user (admin)
# @name create_user_admin
POST {{host}}/api/users
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "name": "doomshop_user_{{run}}",
  "email": "doomshop_user_{{run}}@example.com",
  "password": "123",
  "role": 2
}

###
@new_user_id = {{create_user_admin.response.body.data.id}}

### patch user (admin)
PATCH {{host}}/api/users/{{new_user_id}}
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "city": "Budapest"
}

### delete user (admin)
DELETE {{host}}/api/users/{{new_user_id}}
Accept: application/json
Authorization: Bearer {{admin_token}}


// -------------------------------
// TRACKS
// -------------------------------

### get tracks (public)
GET {{host}}/api/tracks
Accept: application/json

### get track by id (public)
GET {{host}}/api/tracks/1
Accept: application/json

### get track preview stream
GET {{host}}/api/tracks/1/preview
Accept: application/json

### get track source stream (admin token javasolt)
GET {{host}}/api/tracks/1/source
Accept: application/json
Authorization: Bearer {{admin_token}}

### post track (admin)
# @name create_track_admin
POST {{host}}/api/tracks
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "track_title": "REST Track {{run}}",
  "genre_name": "Phonk",
  "track_path": "tracks/demo.mp3",
  "artist_names": ["REST Artist {{run}}"],
  "release_date": "2026-05-06",
  "track_length_sec": 180,
  "preview_start_at": 0,
  "preview_end_at": 30
}

###
@track_id = {{create_track_admin.response.body.data.id}}

### patch track (admin)
PATCH {{host}}/api/tracks/{{track_id}}
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "track_title": "REST Track {{run}} Updated",
  "genre_name": "Phonk",
  "track_path": "tracks/demo.mp3",
  "artist_names": ["REST Artist {{run}}"],
  "release_date": "2026-05-06",
  "track_length_sec": 200,
  "preview_start_at": 0,
  "preview_end_at": 30
}

### regenerate preview (admin)
POST {{host}}/api/tracks/{{track_id}}/regenerate-preview
Accept: application/json
Content-Type: application/json
Authorization: Bearer {{admin_token}}

{
  "preview_start_at": 5,
  "preview_end_at": 25
}

### delete track (admin)
DELETE {{host}}/api/tracks/{{track_id}}
Accept: application/json
Authorization: Bearer {{admin_token}}


